# Copiar a .env y completar. El .env no se commitea ni entra a la imagen de Docker.
# docker compose lo lee solo (desde la carpeta donde lo corrés) para reemplazar
# las ${VARIABLES} de los docker-compose*.yml.

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
# Nombre de la base, usuario y password con los que se conecta la app.
# En docker-compose.yml (desarrollo) son opcionales y tienen estos mismos
# defaults; en docker-compose.prod.yml son obligatorios.
DB=utn_tracker
DB_USER=utn_tracker
DB_PASSWORD=utn_tracker

# Dónde está MySQL. Solo se usan corriendo PHP sin Docker (php -S ...):
# dentro de Docker el compose los fija en "db" y 3306.
MYSQL_IP=127.0.0.1
MYSQL_PORT=3306

# ---------------------------------------------------------------------------
# Autenticación
# ---------------------------------------------------------------------------
# Client ID del OAuth de Google (Google Cloud Console → Credenciales).
# Obligatorio en producción y staging; en desarrollo puede quedar vacío.
GOOGLE_CLIENT_ID=

# Si es "true", habilita POST /api/auth/mock-login: crea/reutiliza un usuario
# de prueba con datos de ejemplo, sin pasar por Google OAuth. Solo para dev.
# En docker-compose.prod.yml está forzado a "false", diga lo que diga acá.
MOCK_AUTH_ENABLED=false

# Carpeta donde se cachean las claves públicas de Google (JWKS).
# Vacío = el directorio temporal del sistema.
CACHE_DIR=

# ---------------------------------------------------------------------------
# Solo desarrollo (docker-compose.yml)
# ---------------------------------------------------------------------------
# Password de root de MySQL (default: root).
#MYSQL_ROOT_PASSWORD=root
# Puertos del host donde se publican la app y MySQL.
#HOST_APP_PORT=8080
#HOST_MYSQL_PORT=3306

# ---------------------------------------------------------------------------
# Solo producción y staging (docker-compose.prod.yml)
# ---------------------------------------------------------------------------
# Red de Docker donde corre Caddy (`docker network ls` en el VPS para verla).
# La app se suma a esa red para que Caddy la alcance por nombre de contenedor.
CADDY_NETWORK=

# Nombre del contenedor de la app: es el que va en el Caddyfile
# (reverse_proxy <nombre>:80). Default: utntracker-app.
# En staging tiene que ser otro para no chocar con prod, p. ej.:
#APP_CONTAINER_NAME=utntracker-app-staging
