{
    "name": "utn-tracker/backend",
    "description": "Backend PHP (sin framework) de UTN-Tracker",
    "require": {
        "php": ">=8.1",
        "firebase/php-jwt": "^7.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite unit",
        "test:api": "phpunit --testsuite api",
        "migrate": "php bin/migrate.php"
    }
}
